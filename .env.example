# Copy to .env (ignored), fill locally. Compose loads .env; mvn spring-boot:run does not.
DB_PASSWORD=
DASHBOARD_API_KEY=
DASHBOARD_ADMIN_EMAIL=
# BCrypt hash; single-quote it in .env so Compose preserves dollar signs.
DASHBOARD_ADMIN_PASSWORD_HASH=
# At least 32 UTF-8 bytes; use a random value, e.g. openssl rand -hex 32.
DASHBOARD_JWT_SECRET=
# 32 random bytes encoded as 64 hex characters; encrypts scheduled feed inputs in the database.
DASHBOARD_SCHEDULE_KEY=
DB_PORT=15432
DASHBOARD_PORT=8084
# Reddit remains disabled unless official approval and all OAuth credentials are present.
REDDIT_API_ACCESS_APPROVED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USERNAME=
FRONTEND_PORT=8085
