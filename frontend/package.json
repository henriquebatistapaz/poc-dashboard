    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "1.69.0",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "2.4.11",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "glob": "14.0.4"
    },
